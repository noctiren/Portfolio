---
// Base layout: <head> meta, the persistent shell (light layer + header), footer and palette.
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Light from '../components/Light.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Palette from '../components/Palette.astro';
import { existsSync } from 'node:fs';
// The two fonts the first screen needs (giant title + body text), preloaded so they don't wait for the CSS.
// Same files the @fontsource CSS points at (Vite gives them the same hashed URL). Latin subset only.
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { person } from '../data/site';
import { cleanPath } from '../data/path';

interface Props {
  title: string;
  description: string;
  /** home page only: hides the header wordmark until the hero name scrolls away */
  heroName?: boolean;
  noindex?: boolean;
}
const { title, description, heroName = false, noindex = false } = Astro.props;
const path = cleanPath(Astro.url.pathname);
const fullTitle = path === '/' ? `${person.name} · ${person.role}` : `${title} · ${person.name}`;
const canonical = new URL(path, Astro.site);
// Link-preview card per page (made by tools/og/make-og.mjs); pages without one use the home card.
const ogKey = path.replace(/^\/|\/$/g, '').replace(/\//g, '-') || 'home';
const ogFile = existsSync(`public/og/${ogKey}.png`) ? ogKey : 'home';
const ogImage = new URL(`/og/${ogFile}.png`, Astro.site);
---
<!doctype html>
<html lang="en" data-hero-name={heroName ? 'in-view' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#04060a" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${fullTitle}: link preview card`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      // Motion switch: .motion normally, .rm under prefers-reduced-motion or ?reduced=1 (kept for the tab
      // via sessionStorage; ?reduced=0 clears it). Runs before first paint and before every page swap.
      (() => {
        const K = 'lp-reduced';
        const read = (url) => {
          const q = new URL(url).searchParams.get('reduced');
          if (q === '1') sessionStorage.setItem(K, '1');
          if (q === '0') sessionStorage.removeItem(K);
          return sessionStorage.getItem(K) === '1' || matchMedia('(prefers-reduced-motion: reduce)').matches;
        };
        const apply = (doc, rm) => {
          const c = doc.documentElement.classList;
          c.add('js');
          c.toggle('rm', rm);
          c.toggle('motion', !rm);
        };
        apply(document, read(location.href));
        if (!window.__lpMotion) {
          window.__lpMotion = true;
          document.addEventListener('astro:before-swap', (e) => apply(e.newDocument, read(e.to.href)));
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Light />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Palette />
    <div class="beam" aria-hidden="true" data-beam transition:persist="beam"></div>
    <script>
      import '../scripts/light';
      import '../scripts/shell';
      import '../scripts/palette';
    </script>
  </body>
</html>
