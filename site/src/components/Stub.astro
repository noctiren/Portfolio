---
// Marker for pages whose content arrives in a later milestone.
interface Props { note?: string }
const { note = 'Full content arrives in milestone M2.' } = Astro.props;
---
<div class="wrap stub">
  <p><span class="todo">TODO</span> {note}</p>
  <slot />
</div>
<style>
  .stub { padding-bottom: var(--s-6); color: var(--muted); }
  .stub > :global(*) { max-width: 44em; }
</style>
