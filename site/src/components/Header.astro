---
// Sticky header, kept across page changes (transition:persist). The active link is updated by
// src/scripts/shell.ts after each navigation, because a persisted element is not re-rendered.
import { nav, person } from '../data/site';
import { build, weight, lighthouse } from '../data/build';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="site-header" transition:persist="header" data-header>
  <div class="wrap bar">
    <a class="mark display" href="/" aria-label={`${person.name}, home`}>
      <span class="b">Luke</span> <span>Petzer</span>
    </a>
    <nav aria-label="Main" class="nav" id="site-nav" data-nav>
      <ul>
        {nav.map((n) => (
          <li>
            <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
          </li>
        ))}
        <li class="rec-li">
          <a class="rec" href="/recruiter" aria-current={isActive('/recruiter') ? 'page' : undefined}>For recruiters</a>
        </li>
      </ul>
    </nav>
    <div class="tools">
      <div class="status" data-status>
        <button type="button" class="pill" aria-label="Site status: all systems operational" aria-expanded="false" aria-controls="status-panel" data-status-btn>
          <span class="dot" aria-hidden="true"></span><span class="pill-txt">All systems operational</span>
        </button>
        <div class="panel" id="status-panel" role="region" aria-label="Site status" hidden data-status-panel>
          <p class="ph"><span class="dot" aria-hidden="true"></span>All systems operational</p>
          <dl>
            <div><dt>Built</dt><dd>{build.builtAt} <span class="u">Cape Town</span></dd></div>
            {build.hash && <div><dt>Commit</dt><dd><code>{build.hash}</code>{build.commitDate && <span class="u"> · {build.commitDate}</span>}</dd></div>}
            {weight && <div><dt>Home page</dt><dd>{weight.codeGz} KB code <span class="u">(gzipped)</span> + {weight.fonts} KB fonts</dd></div>}
            {lighthouse && (
              <div><dt>Lighthouse</dt><dd>
                <span class="lh">mobile {lighthouse.mobile.perf} · {lighthouse.mobile.a11y} · {lighthouse.mobile.seo}</span>
                <span class="lh">desktop {lighthouse.desktop.perf} · {lighthouse.desktop.a11y} · {lighthouse.desktop.seo}</span>
                <span class="u">performance · accessibility · SEO</span>
              </dd></div>
            )}
          </dl>
          <p class="pf">{(weight || lighthouse) && <>Measured {lighthouse?.date ?? weight?.date} on the built home page. </>}<a href="/built">How this site is built</a></p>
        </div>
      </div>
      <button type="button" class="kbd" data-palette-open aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K">
        <span class="visually-hidden">Search: open quick navigation</span>
        <svg class="kbd-icon" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21" /></svg>
        <span class="kbd-label" aria-hidden="true">Search</span>
      </button>
      <button type="button" class="menu-btn" aria-expanded="false" aria-controls="site-nav" data-menu-btn>
        <span class="visually-hidden">Menu</span>
        <span class="bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
  <div class="progress" aria-hidden="true"><i data-progress></i></div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: linear-gradient(180deg, rgba(4, 6, 10, 0.92), rgba(4, 6, 10, 0.72));
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; gap: 28px; height: var(--header-h); }

  .mark {
    font-size: 28px; line-height: 1; letter-spacing: 0.02em; color: var(--text); text-decoration: none; white-space: nowrap;
    padding: 10px 0; /* 44px touch target */
    transition: opacity 0.4s var(--ease-out), transform 0.5s var(--ease-out), letter-spacing 0.5s var(--ease-out);
  }
  .mark .b { color: var(--blue); }
  .mark:hover { color: var(--ice); }
  /* on the home page the big hero name stands in for the wordmark until it scrolls away */
  :global(html[data-hero-name='in-view']) .mark { opacity: 0; transform: translateY(10px); letter-spacing: 0.2em; visibility: hidden; }
  :global(html[data-hero-name='in-view']) .mark { transition: opacity 0.3s, transform 0.3s, letter-spacing 0.3s, visibility 0s 0.3s; }

  .nav { margin-left: auto; }
  .nav ul { list-style: none; display: flex; gap: 26px; margin: 0; padding: 0; }
  .nav a {
    position: relative; display: inline-block; padding: 6px 0;
    font: var(--fs-label) / 1.2 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--muted); text-decoration: none;
  }
  .nav a:hover { color: var(--ice); }
  .nav a[aria-current='page'] { color: var(--text); }
  .nav a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 2px;
    background: var(--blue); box-shadow: 0 0 10px var(--blue); transform: scaleX(0); transform-origin: left;
    transition: transform 0.35s var(--ease-out);
  }
  .nav a[aria-current='page']::after { transform: scaleX(1); }

  .tools { display: flex; align-items: center; gap: 10px; }

  /* "For recruiters" pill: the last nav item, so it is in the mobile menu too */
  .nav .rec {
    padding: 7px 12px; white-space: nowrap; color: var(--ice); border: 1px solid rgba(76, 155, 255, 0.6); background: rgba(76, 155, 255, 0.1);
  }
  .nav .rec:hover, .nav .rec[aria-current='page'] { color: var(--ink); background: var(--ice); border-color: var(--ice); }
  .nav .rec::after { display: none; }

  /* live status pill + panel */
  .status { position: relative; }
  .pill {
    display: inline-flex; align-items: center; gap: 9px; min-height: 36px; padding: 8px 12px; cursor: pointer;
    font: 12px/1 var(--font-mono); letter-spacing: 0.06em; color: var(--muted);
    background: rgba(8, 16, 29, 0.8); border: 1px solid var(--line-strong); border-radius: 999px;
  }
  .pill:hover, .pill[aria-expanded='true'] { color: var(--ice); border-color: var(--ice); }
  .pill:focus-visible { border-radius: 999px; }
  .dot {
    flex: none; width: 8px; height: 8px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 8px 1px rgba(74, 222, 128, 0.7);
  }
  :global(.motion) .pill .dot { animation: breathe 2.8s ease-in-out infinite; }
  @keyframes breathe {
    0%, 100% { opacity: 1; box-shadow: 0 0 8px 1px rgba(74, 222, 128, 0.7); }
    50% { opacity: 0.55; box-shadow: 0 0 2px 0 rgba(74, 222, 128, 0.3); }
  }
  .panel {
    position: absolute; right: 0; top: calc(100% + 12px); z-index: 60; width: 330px; padding: 18px 20px 16px;
    background: var(--bg-raise); border: 1px solid var(--line-strong);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.75), 0 0 40px rgba(76, 155, 255, 0.12);
  }
  .panel[hidden] { display: none; }
  .ph { display: flex; align-items: center; gap: 10px; margin: 0 0 12px; font: 700 13px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--text); }
  .panel dl { margin: 0; display: grid; gap: 10px; }
  .panel dl div { display: grid; grid-template-columns: 92px 1fr; gap: 12px; border-top: 1px solid var(--line); padding-top: 10px; }
  .panel dt { font: 12px/1.5 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .panel dd { margin: 0; font-size: 14px; line-height: 1.5; color: var(--text); }
  .panel code { font: 13px var(--font-mono); color: var(--ice); }
  .panel .u { color: var(--muted); font-size: 13px; }
  .panel .lh { display: block; font: 13px/1.6 var(--font-mono); }
  .pf { margin: 14px 0 0; padding-top: 10px; border-top: 1px solid var(--line); font-size: 13px; color: var(--muted); }
  .kbd { display: inline-flex; align-items: center; gap: 8px; min-height: 36px; }
  .kbd-icon { flex: none; }
  .kbd, .menu-btn {
    font: 12px/1 var(--font-mono); letter-spacing: 0.08em; color: var(--muted);
    background: rgba(8, 16, 29, 0.8); border: 1px solid var(--line-strong); padding: 8px 10px; cursor: pointer;
  }
  .kbd:hover, .menu-btn:hover { color: var(--ice); border-color: var(--ice); }
  .menu-btn { display: none; width: 44px; height: 44px; padding: 0; }
  .bars { display: grid; gap: 6px; justify-items: center; }
  .bars i { display: block; width: 20px; height: 2px; background: currentColor; transition: transform 0.3s var(--ease-out); }
  .menu-btn[aria-expanded='true'] .bars i:first-child { transform: translateY(4px) rotate(45deg); }
  .menu-btn[aria-expanded='true'] .bars i:last-child { transform: translateY(-4px) rotate(-45deg); }

  .progress { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; overflow: hidden; }
  .progress i {
    display: block; height: 100%; background: linear-gradient(90deg, var(--blue), var(--ice));
    box-shadow: 0 0 12px var(--blue); transform: scaleX(0); transform-origin: left;
  }

  @media (max-width: 860px) {
    .mark { font-size: 24px; }
    .menu-btn { display: inline-grid; place-items: center; }
    .kbd { height: 44px; }
    .nav {
      position: absolute; top: 100%; left: 0; right: 0; margin: 0;
      background: var(--bg); border-bottom: 1px solid var(--line); box-shadow: 0 24px 40px rgba(0, 0, 0, 0.6);
      display: none;
    }
    .nav[data-open] { display: block; }
    .nav ul { flex-direction: column; gap: 0; padding: 8px var(--gutter) 20px; }
    .nav a { display: block; padding: 14px 0; font-size: 15px; border-bottom: 1px solid var(--line); }
    .nav a::after { bottom: 10px; right: auto; width: 32px; }
    .bar { gap: 12px; }
    .tools { margin-left: auto; }
  }
  /* narrow screens: the Search button and the status pill shrink to 44px icons (same controls) */
  @media (max-width: 1240px) {
    .pill { width: 36px; height: 36px; padding: 0; justify-content: center; }
    .pill-txt { display: none; }
  }
  @media (min-width: 861px) and (max-width: 1040px) {
    .bar { gap: 16px; }
    .nav ul { gap: 16px; }
    .nav a { letter-spacing: 0.08em; }
    .nav .rec { padding: 7px 9px; }
    .mark { font-size: 24px; }
  }
  @media (max-width: 860px) {
    .kbd { width: 44px; height: 44px; padding: 0; display: inline-grid; place-items: center; }
    .kbd-label { display: none; }
    .kbd-icon { width: 20px; height: 20px; }
    .pill { width: 44px; height: 44px; }
    .nav .rec-li { padding-top: 16px; }
    .nav .rec { display: inline-block; padding: 12px 16px; border-bottom: 1px solid rgba(76, 155, 255, 0.6); }
    .panel { position: fixed; left: var(--gutter); right: var(--gutter); top: calc(var(--header-h) + 8px); width: auto; }
  }
</style>
