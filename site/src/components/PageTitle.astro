---
// The giant lit title each page opens with (D-007 #2).
interface Props {
  title: string;
  kicker?: string;
  /** second line, drawn as an outline */
  outline?: string;
  /** smaller size for long titles (case studies) */
  long?: boolean;
}
const { title, kicker, outline, long = false } = Astro.props;
---
<header class="page-title wrap">
  {kicker && <p class="label kicker">{kicker}</p>}
  <h1 class:list={['display cast shadow-text', { long }]}>
    <span>{title}</span>
    {outline && <span class="outline">{outline}</span>}
  </h1>
  <slot />
</header>

<style>
  .page-title { padding-top: clamp(40px, 9vh, 110px); padding-bottom: var(--s-4); }
  .kicker { margin: 0 0 16px; }
  h1 { font-size: var(--fs-title); margin: 0; overflow-wrap: anywhere; }
  h1.long { font-size: clamp(52px, 9vw, 140px); line-height: 0.9; }
  h1 span { display: block; }
  :global(.motion) h1 span { animation: rise 1.1s var(--ease-out) both; }
  :global(.motion) h1 span + span { animation-delay: 0.12s; }
</style>
