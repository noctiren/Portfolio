---
// The opcode diagram: owner → manager → one worker per task, inside a guardrail frame, with an inbox path
// back to the owner. Same pattern as Pipeline.astro: a wide drawing and a phone drawing (only one is shown),
// SMIL light packets, hidden under reduced motion.
interface Node { x: number; y: number; w: number; t: string; s: string; worker?: boolean; owner?: boolean }
interface Edge { id: string; d: string; begin: string; share: number; inbox?: boolean }
interface Frame { x: number; y: number; w: number; h: number; lx: number; ly: number }
interface Inbox { lx: number; ly: number; anchor: 'middle' | 'end' }
interface Drawing { key: string; viewBox: string; nodes: Node[]; edges: Edge[]; frame: Frame; inbox: Inbox }

const H = 56;
const drawings: Drawing[] = [
  {
    key: 'h',
    viewBox: '0 0 640 336',
    frame: { x: 384, y: 6, w: 250, h: 320, lx: 509, ly: 312 },
    inbox: { lx: 162, ly: 70, anchor: 'middle' },
    nodes: [
      { x: 6, y: 124, w: 118, t: 'Owner', s: 'decides', owner: true },
      { x: 200, y: 124, w: 120, t: 'Manager', s: 'plans · starts' },
      { x: 424, y: 24, w: 170, t: 'Worker', s: 'task 1', worker: true },
      { x: 424, y: 124, w: 170, t: 'Worker', s: 'task 2', worker: true },
      { x: 424, y: 224, w: 170, t: 'Worker', s: 'task 3', worker: true },
    ],
    edges: [
      { id: 'a', d: 'M124 152 H200', begin: '0s', share: 0.2 },
      { id: 'w1', d: 'M320 152 C372 152 372 52 424 52', begin: '.6s', share: 0.3 },
      { id: 'w2', d: 'M320 152 H424', begin: '.6s', share: 0.3 },
      { id: 'w3', d: 'M320 152 C372 152 372 252 424 252', begin: '.6s', share: 0.3 },
      { id: 'in', d: 'M260 124 C260 72 65 72 65 124', begin: '1.6s', share: 0.35, inbox: true },
    ],
  },
  {
    key: 'v',
    viewBox: '0 0 320 352',
    frame: { x: 4, y: 196, w: 312, h: 150, lx: 160, ly: 330 },
    inbox: { lx: 26, ly: 92, anchor: 'middle' },
    nodes: [
      { x: 90, y: 4, w: 140, t: 'Owner', s: 'decides', owner: true },
      { x: 90, y: 110, w: 140, t: 'Manager', s: 'plans · starts' },
      { x: 12, y: 222, w: 92, t: 'Worker', s: 'task 1', worker: true },
      { x: 114, y: 222, w: 92, t: 'Worker', s: 'task 2', worker: true },
      { x: 216, y: 222, w: 92, t: 'Worker', s: 'task 3', worker: true },
    ],
    edges: [
      { id: 'a', d: 'M160 60 V110', begin: '0s', share: 0.2 },
      { id: 'w1', d: 'M160 166 C160 196 58 192 58 222', begin: '.6s', share: 0.3 },
      { id: 'w2', d: 'M160 166 V222', begin: '.6s', share: 0.3 },
      { id: 'w3', d: 'M160 166 C160 196 262 192 262 222', begin: '.6s', share: 0.3 },
      { id: 'in', d: 'M90 138 C40 138 40 32 90 32', begin: '1.6s', share: 0.35, inbox: true },
    ],
  },
];
const label =
  'How my opcode setup fits together: the owner gives a goal to a manager chat, which plans the work and starts one worker chat per task. The workers run inside guardrails: model and effort caps, budgets, file locks and rule files. Decisions only the owner may make go back to the owner as inbox cards.';
---
<figure class="opd">
  {drawings.map((g) => (
    <svg class={`flow flow-${g.key}`} viewBox={g.viewBox} role="img" aria-label={label}>
      <defs>
        <filter id={`obloom-${g.key}`} x="-200%" y="-200%" width="500%" height="500%">
          <feGaussianBlur stdDeviation="2.5" result="b" />
          <feMerge><feMergeNode in="b" /><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
      </defs>
      <rect class="frame" x={g.frame.x} y={g.frame.y} width={g.frame.w} height={g.frame.h} />
      <text class="fl" x={g.frame.lx} y={g.frame.ly}>caps · budgets · locks · rules</text>
      {g.edges.map((e) => <path id={`o-${g.key}-${e.id}`} class:list={['edge', { inbox: e.inbox }]} d={e.d} />)}
      <text class="il" x={g.inbox.lx} y={g.inbox.ly} text-anchor={g.inbox.anchor}>inbox</text>
      {g.nodes.map((n) => (
        <g class:list={['node', { worker: n.worker, owner: n.owner }]}>
          <rect x={n.x} y={n.y} width={n.w} height={H} />
          <text class="t" x={n.x + n.w / 2} y={n.y + 27}>{n.t}</text>
          <text class="s" x={n.x + n.w / 2} y={n.y + 45}>{n.s}</text>
        </g>
      ))}
      <g aria-hidden="true">
        {g.edges.map((e) => (
          <circle class:list={['pkt', { warm: e.inbox }]} opacity="0" r="4" filter={`url(#obloom-${g.key})`}>
            <animateMotion dur="3s" begin={e.begin} repeatCount="indefinite" keyPoints="0;1;1" keyTimes={`0;${e.share};1`} calcMode="linear">
              <mpath href={`#o-${g.key}-${e.id}`} />
            </animateMotion>
            <animate attributeName="opacity" dur="3s" begin={e.begin} repeatCount="indefinite" values="1;1;0;0" keyTimes={`0;${e.share};${e.share + 0.01};1`} />
          </circle>
        ))}
      </g>
    </svg>
  ))}
  <figcaption>How it fits together: one manager per project, one worker per task, all inside the guardrails. Owner-only decisions come back to me as inbox cards.</figcaption>
</figure>

<style>
  .opd { margin: 0 0 48px; }
  .opd :global(svg.flow) { width: 100%; height: auto; display: block; overflow: visible; }
  .flow-v { display: none !important; max-width: 340px; margin: 0 auto; }
  @media (max-width: 640px) {
    .flow-h { display: none !important; }
    .flow-v { display: block !important; }
  }
  .frame { fill: rgba(76, 155, 255, 0.04); stroke: rgba(76, 155, 255, 0.55); stroke-width: 1.2; stroke-dasharray: 6 5; }
  .fl, .il { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; text-anchor: middle; }
  .fl { fill: var(--blue); }
  .il { fill: var(--warn); }
  .edge { fill: none; stroke: rgba(76, 155, 255, 0.45); stroke-width: 1.5; }
  .edge.inbox { stroke: rgba(255, 213, 138, 0.6); stroke-dasharray: 4 4; }
  .node rect { fill: var(--bg-raise); stroke: rgba(207, 228, 255, 0.55); stroke-width: 1.2; }
  .node.worker rect { stroke: var(--blue); fill: var(--bg-panel); }
  .node.owner rect { stroke: var(--ice); }
  .t { font-family: var(--font-display); font-stretch: var(--stretch-display); font-size: 20px; font-weight: 800; letter-spacing: 0.04em; fill: var(--text); text-anchor: middle; text-transform: uppercase; }
  .s { font-family: var(--font-mono); font-size: 12.5px; fill: var(--muted); text-anchor: middle; }
  .pkt { fill: var(--ice); }
  .pkt.warm { fill: var(--warn); }
  :global(.rm) .pkt { display: none; }
  figcaption { margin-top: 16px; color: var(--muted); font-size: var(--fs-small); max-width: 40em; }
</style>
