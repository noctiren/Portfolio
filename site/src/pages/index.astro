---
import Base from '../layouts/Base.astro';
import Pipeline from '../components/Pipeline.astro';
import { person } from '../data/site';
import { getWork } from '../data/work';
const caseStudies = await getWork();

const stats = [
  { n: '60–80%', p: 'Backup storage cost cut with GCS lifecycle policies.' },
  { n: '28–36%', p: 'Savings shown for multi-cloud vs. AWS-only.' },
  { n: '3', p: 'Clouds on one Terraform platform: AWS, GCP, Vultr.' },
  { n: 'Zero', p: "Downtime migrating every live user's envelope data." },
];

const tiles = [
  {
    href: '/work',
    idx: '01',
    title: 'Work',
    text: `${caseStudies.length} case studies: a multi-cloud Terraform platform, a GitOps and secrets overhaul, an identity verification platform and a zero-downtime migration.`,
    cta: 'See the work',
  },
  {
    href: '/experience',
    idx: '02',
    title: 'Experience',
    text: 'DevOps at ixo, backend at BMTX and envel, and the road there: Younglings and an internship at Absa.',
    cta: 'Read the timeline',
  },
  {
    href: '/ai',
    idx: '03',
    title: 'AI',
    text: 'Open to roles that include AI. I run and tune generative-AI stacks locally, end to end, and build tooling around AI coding agents.',
    cta: 'See the AI work',
    draft: true,
  },
];
---
<Base
  title="Home"
  description="Luke Petzer, DevOps / Platform Engineer in Cape Town with a Java/Kotlin/Spring backend background: multi-cloud Terraform, Kubernetes, ArgoCD and GitOps."
  heroName
>
  <div class="wrap hero">
    <div>
      <p class="label kicker">{person.location}</p>
      <h1 class="name display cast shadow-text" data-hero-target><span>Luke</span><span class="outline">Petzer</span></h1>
    </div>
    <div class="hero-foot">
      <div class="rv">
        <p class="role display">{person.role}</p>
        <p class="pitch">{person.pitch}</p>
      </div>
      <div class="btns rv">
        <a class="btn primary mag" href="/work">View work</a>
        {/* TODO(Luke): replace with phone-free CV before hosting (HR-PRIVACY) */}
        <a class="btn mag" href={person.cv} download>Download CV</a>
        <a class="btn mag" href="/contact">Contact</a>
      </div>
    </div>
  </div>

  <section class="band" aria-labelledby="pipe-h">
    <div class="wrap">
      <div class="rv">
        <h2 id="pipe-h" class="label">The pipeline</h2>
        <p>Push, build, sync, three clouds. Every change goes through Git.</p>
      </div>
      <Pipeline />
    </div>
  </section>

  <section aria-labelledby="impact-h">
    <div class="wrap">
      <div class="sh"><span class="idx" aria-hidden="true">01</span><h2 id="impact-h" class="display wipe cast shadow-text">Impact</h2></div>
      <div class="stats rv">
        {stats.map((s) => (
          <div class="stat">
            <p class="n display cast shadow-text">{s.n}</p>
            <p>{s.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="explore-h">
    <div class="wrap">
      <div class="sh"><span class="idx" aria-hidden="true">02</span><h2 id="explore-h" class="display wipe cast shadow-text">Explore</h2></div>
      <ul class="tiles">
        {tiles.map((t) => (
          <li class="tile cast shadow-box rv">
            <span class="num display" aria-hidden="true">{t.idx}</span>
            <h3 class="display">
              <a href={t.href}>{t.title}</a>
              {t.draft && <span class="draft">draft</span>}
            </h3>
            <p>{t.text}</p>
            <span class="more" aria-hidden="true">{t.cta} →</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="cta" aria-labelledby="cta-h">
    <div class="wrap">
      <h2 id="cta-h" class="big display cast shadow-text rv">Get in<br /><span class="outline">touch</span></h2>
      <div class="cta-row rv">
        <p>Hiring for DevOps, platform or backend work? Get in touch by email or on LinkedIn.</p>
        <div class="btns">
          <a class="btn primary mag" href={`mailto:${person.email}`}>Email me</a>
          <a class="btn mag" href={person.linkedin} rel="noopener">LinkedIn</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- hero ---- */
  .hero { min-height: min(calc(100svh - var(--header-h)), 900px); display: grid; grid-template-rows: 1fr auto; padding-top: 4vh; padding-bottom: 48px; }
  .kicker { margin: 0 0 16px; letter-spacing: 0.24em; }
  .name { font-size: var(--fs-mega); line-height: 0.8; margin: 0; }
  .name span { display: block; }
  :global(.motion) .name span { animation: rise 1.2s var(--ease-out) both; }
  :global(.motion) .name span + span { animation-delay: 0.15s; }
  .hero-foot { display: grid; grid-template-columns: 1.3fr 1fr; gap: 48px; align-items: end; margin-top: 40px; }
  .role { font-size: clamp(26px, 3vw, 40px); font-weight: 700; letter-spacing: 0.02em; line-height: 1.1; color: var(--ice); margin: 0 0 14px; }
  .pitch { color: var(--muted); max-width: 36em; margin: 0; }
  .hero .btns { justify-content: flex-end; }

  /* ---- pipeline band ---- */
  .band {
    padding: 40px 0 28px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(10, 18, 32, 0.55), rgba(4, 6, 10, 0.2));
  }
  .band .wrap { display: grid; grid-template-columns: 220px 1fr; gap: 40px; align-items: center; }
  .band h2 { margin: 0 0 8px; letter-spacing: 0.24em; }
  .band p { color: var(--muted); font-size: var(--fs-small); margin: 0; }

  /* ---- impact ---- */
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); }
  .stat { padding: 28px 24px 8px 0; }
  .stat + .stat { padding-left: 24px; border-left: 1px solid var(--line); }
  .stat .n { font-size: clamp(48px, 5.4vw, 80px); line-height: 0.9; margin: 0; white-space: nowrap; }
  .stat p:not(.n) { color: var(--muted); font-size: var(--fs-small); margin: 14px 0 0; }

  /* ---- teaser tiles ---- */
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .tile {
    position: relative; padding: 36px 32px 32px; display: flex; flex-direction: column;
    background: linear-gradient(140deg, rgba(14, 28, 54, 0.9), rgba(6, 10, 18, 0.7));
    transition: transform var(--dur) var(--ease-out);
  }
  .tile .num {
    font-size: 110px; line-height: 0.75; color: transparent; -webkit-text-stroke: 1.5px rgba(207, 228, 255, 0.3);
    margin-bottom: 20px; transition: -webkit-text-stroke-color 0.4s, color 0.4s;
  }
  .tile h3 { font-size: var(--fs-h3); margin: 0 0 12px; display: flex; align-items: center; gap: 14px; }
  .tile h3 a { color: var(--text); text-decoration: none; }
  /* the whole tile is the link target; the heading link stays the one focusable element */
  .tile h3 a::after { content: ''; position: absolute; inset: 0; }
  .tile h3 a:focus-visible { box-shadow: none; outline: none; }
  .tile:has(a:focus-visible) { outline: 2px solid var(--ice); outline-offset: 4px; box-shadow: var(--focus-ring); }
  .tile p { color: var(--muted); margin: 0 0 20px; flex: 1; }
  .tile .more { font: 700 var(--fs-label) var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--ice); }
  .tile:hover .num { -webkit-text-stroke-color: var(--blue); color: rgba(76, 155, 255, 0.12); }
  .tile:hover .more { text-decoration: underline; text-underline-offset: 4px; }
  :global(.motion) .tile:hover { transform: translateY(-6px); }

  /* ---- contact CTA ---- */
  .cta { padding-bottom: var(--s-6); }
  .big { font-size: clamp(64px, 12vw, 180px); line-height: 0.82; margin: 0 0 40px; }
  .cta-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px 48px; }
  .cta-row p { color: var(--muted); max-width: 30em; margin: 0; font-size: 19px; }

  @media (max-width: 900px) {
    .hero { min-height: auto; padding-top: 32px; }
    .hero-foot { grid-template-columns: 1fr; gap: 28px; }
    .hero .btns { justify-content: flex-start; }
    .band .wrap { grid-template-columns: 1fr; gap: 20px; }
    .stats { grid-template-columns: 1fr 1fr; }
    .stat:nth-child(3) { padding-left: 0; border-left: 0; }
    .stat:nth-child(n + 3) { border-top: 1px solid var(--line); }
    .tiles { grid-template-columns: 1fr; }
    .tile .num { font-size: 80px; }
  }
  @media (max-width: 560px) {
    .stat { padding-right: 12px; }
    .stat + .stat { padding-left: 12px; }
    .stat .n { font-size: 44px; }
    .tile { padding: 28px 22px 24px; }
  }
</style>
