---
// /recruiter (D-009): one calm page a recruiter can scan in a minute, and print as a 1-page profile.
// Minimal motion: no reveals, no long shadows, no title rise. Facts: docs/content/cv.md + answers.md Q-18.
import Base from '../layouts/Base.astro';
import { person } from '../data/site';
import { jobs, skills, education, certification } from '../data/cv';
import { getWork } from '../data/work';

const work = await getWork();
// Three highlights, one per kind of role Luke is open to: platform, backend, AI.
const highlightIds = ['multi-cloud-terraform', 'identity-verification', 'opcode'];
const highlights = highlightIds.map((id) => work.find((w) => w.id === id)).filter((w) => w !== undefined);

const numbers = [
  { n: '60–80%', p: 'backup storage cost cut (GCS lifecycle policies)' },
  { n: '28–36%', p: 'savings shown for multi-cloud vs. AWS-only' },
  { n: '3', p: 'clouds on one Terraform platform' },
  { n: 'Zero', p: "downtime migrating every live user's envelope data" },
];

const topSkills = skills.filter((g) => g.group !== 'Web3');
---
<Base
  title="For recruiters"
  description="Luke Petzer at a glance: DevOps / Platform Engineer in Cape Town, open to remote DevOps, platform, cloud, backend and AI-related roles. Key numbers, skills, highlights and contact."
>
  <div class="wrap rp">
    <header class="top">
      <p class="label kicker">For recruiters · profile at a glance</p>
      <h1 class="display"><span>Luke</span> <span class="outline">Petzer</span></h1>
      <p class="role">{person.role}</p>
      <p class="intro">
        I run Kubernetes, Terraform and ArgoCD across three clouds (AWS, GCP, Vultr) at ixo. My background is backend
        engineering in Java/Kotlin and Spring, so I still think like a developer when I build infrastructure.
      </p>
    </header>

    <dl class="facts">
      <div class="fact">
        <dt class="label">Open to</dt>
        <dd><ul class="roles">{person.openTo.map((r) => <li>{r}</li>)}</ul></dd>
      </div>
      <div class="fact">
        <dt class="label">Work setup</dt>
        <dd>{person.workSetup}</dd>
      </div>
      <div class="fact">
        <dt class="label">Contact</dt>
        <dd>
          <ul class="contact">
            <li><a class="btn primary" href={`mailto:${person.email}`}>{person.email}</a></li>
            <li><a class="btn" href={person.linkedin} rel="me noopener">LinkedIn <span class="sub">{person.linkedinLabel}</span></a></li>
            <li><a class="btn" href={person.github} rel="me noopener">GitHub <span class="sub">{person.githubLabel}</span></a></li>
          </ul>
        </dd>
      </div>
    </dl>

    <section class="blk" aria-labelledby="num-h">
      <h2 id="num-h" class="label">Key numbers</h2>
      <ul class="nums">
        {numbers.map((x) => (
          <li><span class="n display">{x.n}</span><span class="p">{x.p}</span></li>
        ))}
      </ul>
    </section>

    <div class="two">
      <section class="blk" aria-labelledby="sk-h">
        <h2 id="sk-h" class="label">Top skills</h2>
        <dl class="skills">
          {topSkills.map((g) => (
            <div><dt>{g.group}</dt><dd>{g.items.join(' · ')}</dd></div>
          ))}
        </dl>
      </section>

      <section class="blk" aria-labelledby="tl-h">
        <h2 id="tl-h" class="label">Timeline</h2>
        <ol class="tl">
          {jobs.map((j) => (
            <li>
              <span class="when">{j.period}</span>
              <span class="what"><strong>{j.role}</strong>, {j.org}</span>
            </li>
          ))}
        </ol>
        <p class="ed">{certification} · {education.school}, {education.years}</p>
      </section>
    </div>

    <section class="blk" aria-labelledby="hl-h">
      <h2 id="hl-h" class="label">Highlights</h2>
      <ul class="hl">
        {highlights.map((w) => (
          <li class="card">
            <p class="co">{w.data.company}</p>
            <h3><a href={`/work/${w.id}`}>{w.data.title}</a></h3>
            <p class="sum">{w.data.summary}</p>
          </li>
        ))}
      </ul>
    </section>

    <p class="more-links"><a href="/experience">Full experience</a> · <a href="/work">All case studies</a> · <a href="/ai">AI work</a></p>
  </div>
</Base>

<style>
  .rp { padding-top: clamp(32px, 6vh, 72px); padding-bottom: var(--s-5); }
  .kicker { margin: 0 0 14px; letter-spacing: 0.24em; }
  h1 { font-size: clamp(56px, 9vw, 120px); line-height: 0.85; margin: 0; }
  .role { font: 700 clamp(20px, 2.2vw, 28px) / 1.2 var(--font-display); font-stretch: var(--stretch-display); text-transform: uppercase; letter-spacing: 0.04em; color: var(--ice); margin: 14px 0 10px; }
  .intro { max-width: 44em; color: var(--muted); font-size: 18px; margin: 0; }

  .facts { margin: 36px 0 0; display: grid; grid-template-columns: 1.1fr 0.9fr 1.3fr; border-top: 1px solid var(--line-strong); border-bottom: 1px solid var(--line-strong); }
  .fact { padding: 20px 24px 22px 0; }
  .fact + .fact { padding-left: 24px; border-left: 1px solid var(--line); }
  .facts dt { margin: 0 0 10px; }
  .facts dd { margin: 0; color: var(--text); }
  .roles { list-style: none; margin: 0; padding: 0; }
  .roles li { padding: 2px 0 2px 18px; position: relative; }
  .roles li::before { content: ''; position: absolute; left: 0; top: 0.8em; width: 9px; height: 2px; background: var(--blue); }
  .contact { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .contact .btn { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 12px 14px; text-transform: none; letter-spacing: 0.02em; overflow-wrap: anywhere; }
  .contact .sub { font-weight: 400; opacity: 0.85; }

  .blk { padding: 0; margin-top: 40px; }
  .blk h2 { margin: 0 0 14px; }
  .nums { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border-top: 1px solid var(--line); }
  .nums li { padding: 16px 16px 4px 0; display: grid; gap: 8px; align-content: start; }
  .nums li + li { padding-left: 16px; border-left: 1px solid var(--line); }
  .nums .n { font-size: clamp(40px, 4vw, 56px); line-height: 0.9; color: var(--text); }
  .nums .p { color: var(--muted); font-size: var(--fs-small); line-height: 1.45; }

  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .skills { margin: 0; display: grid; gap: 10px; }
  .skills div { display: grid; grid-template-columns: 150px 1fr; gap: 12px; border-top: 1px solid var(--line); padding-top: 10px; }
  .skills dt { font: 12.5px/1.6 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .skills dd { margin: 0; font-size: var(--fs-small); color: var(--text); }
  .tl { list-style: none; margin: 0; padding: 0; }
  .tl li { display: grid; grid-template-columns: 150px 1fr; gap: 12px; border-top: 1px solid var(--line); padding: 10px 0 0; margin-bottom: 10px; font-size: var(--fs-small); }
  .tl .when { font: 12.5px/1.6 var(--font-mono); color: var(--muted); }
  .tl strong { font-weight: 650; color: var(--text); }
  .tl .what { color: var(--muted); }
  .ed { margin: 14px 0 0; padding-top: 10px; border-top: 1px solid var(--line); color: var(--muted); font-size: var(--fs-small); }

  .hl { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .card { position: relative; padding: 20px 22px; background: var(--bg-raise); border: 1px solid var(--line-strong); }
  .card:hover { border-color: var(--blue); }
  .card .co { margin: 0 0 6px; font: 12px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--blue); }
  .card h3 { margin: 0 0 8px; font-size: 19px; line-height: 1.3; }
  .card h3 a { color: var(--text); text-decoration: none; }
  .card h3 a::after { content: ''; position: absolute; inset: 0; }
  .card h3 a:focus-visible { outline: none; box-shadow: none; }
  .card:has(a:focus-visible) { outline: 2px solid var(--ice); outline-offset: 3px; box-shadow: var(--focus-ring); }
  .card:hover h3 a { color: var(--ice); }
  .card .sum { margin: 0; color: var(--muted); font-size: 14.5px; line-height: 1.55; }
  .more-links { margin: 32px 0 0; color: var(--muted); font-size: var(--fs-small); }

  @media (max-width: 960px) {
    .facts { grid-template-columns: 1fr 1fr; }
    .fact + .fact:nth-child(3) { grid-column: 1 / -1; padding-left: 0; border-left: 0; border-top: 1px solid var(--line); }
    .two { grid-template-columns: 1fr; gap: 0; }
    .hl { grid-template-columns: 1fr; }
    .nums { grid-template-columns: 1fr 1fr; }
    .nums li + li:nth-child(3) { padding-left: 0; border-left: 0; }
    .nums li:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 560px) {
    .facts { grid-template-columns: 1fr; }
    .fact + .fact { padding-left: 0; border-left: 0; border-top: 1px solid var(--line); }
    .skills div, .tl li { grid-template-columns: 1fr; gap: 2px; }
    .nums .n { font-size: 38px; }
    .intro { font-size: 17px; }
  }

  /* ---- print: one A4 page. Two columns where it saves space; links print as their text (addresses shown). ---- */
  @media print {
    @page { margin: 11mm 12mm; }
    .rp { padding: 0 !important; font-size: 9pt; line-height: 1.35; }
    .kicker { margin: 0 0 2pt !important; font-size: 7.5pt !important; }
    h1 { font-size: 24pt !important; }
    h1 .outline::before { content: none !important; }
    .role { font-size: 11pt !important; margin: 2pt 0 3pt !important; }
    .intro { font-size: 9.5pt !important; max-width: none !important; }
    .facts { margin-top: 8pt !important; grid-template-columns: 1.1fr 0.9fr 1.3fr !important; border-color: #888 !important; }
    .fact { padding: 5pt 8pt 6pt 0 !important; }
    .fact + .fact { padding-left: 8pt !important; border-left: 1px solid #bbb !important; border-top: 0 !important; }
    .fact + .fact:nth-child(3) { grid-column: auto !important; border-top: 0 !important; padding-left: 8pt !important; border-left: 1px solid #bbb !important; }
    .contact { gap: 1pt !important; }
    .contact .btn { display: block !important; padding: 0 !important; border: 0 !important; font: 9pt var(--font-body) !important; text-decoration: underline; }
    .contact .btn::after, .rp a[href]::after { content: none !important; }
    .blk { margin-top: 9pt !important; }
    .blk h2 { margin: 0 0 4pt !important; font-size: 8pt !important; }
    .nums { grid-template-columns: repeat(4, 1fr) !important; }
    .nums li { padding: 3pt 6pt 0 0 !important; gap: 1pt !important; border-top: 0 !important; }
    .nums li + li { padding-left: 6pt !important; border-left: 1px solid #bbb !important; }
    .nums .n { font-size: 18pt !important; }
    .nums .p { font-size: 8pt !important; }
    .two { grid-template-columns: 1fr 1fr !important; gap: 14pt !important; }
    .skills { gap: 2pt !important; }
    .skills div, .tl li { grid-template-columns: 26mm 1fr !important; gap: 4pt !important; padding-top: 2pt !important; margin-bottom: 2pt !important; border-color: #ccc !important; }
    .skills dt, .tl .when { font-size: 7.5pt !important; }
    .skills dd, .tl li { font-size: 8.5pt !important; }
    .ed { font-size: 8pt !important; margin-top: 4pt !important; padding-top: 3pt !important; }
    .hl { grid-template-columns: repeat(3, 1fr) !important; gap: 8pt !important; }
    .card { padding: 5pt 6pt !important; border: 1px solid #aaa !important; }
    .card h3 { font-size: 10pt !important; margin: 0 0 2pt !important; }
    .card .sum { font-size: 8pt !important; line-height: 1.35 !important; }
    .more-links { display: none !important; }
    :global(.site-footer) { display: none !important; }
  }
</style>
