---
// Facts about this site come from the repo itself. Hosting went live at M5 (Luke 2026-11-15, DECISIONS D-003):
// infra/ (Terraform) and .github/workflows/site.yml in the public repo.
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import { person } from '../data/site';

const parts = [
  {
    t: 'Astro, static',
    p: 'Every page is plain HTML built ahead of time. No server and no database: a portfolio is static content, so it is served as files.',
  },
  {
    t: 'Very little JavaScript',
    p: 'Pages work without scripts. A few small hand-written ones add the moving light, the header behaviour, the card tilt and the Ctrl/Cmd+K palette. No UI framework is shipped to the browser.',
  },
  {
    t: 'Plain CSS + design tokens',
    p: 'One file of CSS variables holds every colour, size, shadow and timing. Every text colour passes WCAG AA contrast on the dark background.',
  },
  {
    t: 'Self-hosted fonts',
    p: 'Archivo (condensed headings), Inter (body) and JetBrains Mono (labels) are bundled with the site, so no requests go to a font service.',
  },
  {
    t: 'View Transitions',
    p: 'Pages swap in place: the header and the light layer stay put between pages, so the site feels like one continuous dark space.',
  },
  {
    t: 'Content as Markdown',
    p: 'Case studies are Markdown files in a content collection, checked against a schema at build time. Every fact traces back to my CV or my own answers.',
  },
  {
    t: 'Accessible motion',
    p: 'Keyboard focus is always visible, there is a skip link, and every animation switches off under the reduced-motion setting.',
  },
];

const steps = [
  { t: 'GitHub', s: 'push to main' },
  { t: 'GitHub Actions', s: 'check · build' },
  { t: 'Terraform', s: 'Pages project · HCP state' },
  { t: 'Cloudflare Pages', s: 'deploy · serve' },
];
---
<Base title="How this site is built" description="How Luke Petzer's portfolio is built: Astro, plain CSS design tokens and TypeScript, hosted on Cloudflare Pages, defined in Terraform and deployed by GitHub Actions.">
  <PageTitle title="Built" outline="in the open" kicker="How this site is built">
    <p class="intro">A small site, built the way I'd build a platform: few moving parts and everything in Git.</p>
  </PageTitle>

  <section class="first" aria-labelledby="stack-h">
    <div class="wrap">
      <div class="sh"><span class="idx" aria-hidden="true">01</span><h2 id="stack-h" class="display wipe cast shadow-text">The stack</h2></div>
      <ul class="parts">
        {parts.map((p) => (
          <li class="part rv">
            <h3>{p.t}</h3>
            <p>{p.p}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="last" aria-labelledby="ship-h">
    <div class="wrap">
      <div class="sh"><span class="idx" aria-hidden="true">02</span><h2 id="ship-h" class="display wipe cast shadow-text">Shipping it</h2></div>
      <p class="lede rv"><span class="live">Live</span> Every push to main runs this pipeline. The hosting itself is defined in Terraform, with its state kept in HCP Terraform, and nothing is clicked together by hand. The workflow and the Terraform are in the <a href={`${person.github}/Portfolio`}>public repo</a>.</p>
      <ol class="steps rv" aria-label="Deploy pipeline">
        {steps.map((s, i) => (
          <li>
            <span class="i" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="t display">{s.t}</span>
            <span class="s">{s.s}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  .intro { color: var(--muted); max-width: 36em; font-size: 19px; margin: 28px 0 0; }
  .first { padding-top: var(--s-4); }
  .parts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 0 48px; }
  .part { border-top: 1px solid var(--line); padding: 22px 0 28px; }
  .part h3 { font: 700 var(--fs-label) / 1.3 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ice); margin: 0 0 10px; }
  .part p { color: var(--muted); margin: 0; }

  .lede { color: var(--muted); max-width: 42em; margin: -16px 0 40px; }
  .live {
    display: inline-block; margin-right: 10px; font: 11px/1.5 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ice); border: 1px solid var(--blue); padding: 2px 8px;
  }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); }
  .steps li {
    position: relative; display: flex; flex-direction: column; gap: 8px; padding: 24px 22px;
    border: 1px solid var(--line-strong); background: rgba(8, 16, 29, 0.6);
  }
  .steps li + li { border-left: 0; }
  /* connector arrows between the stages */
  .steps li + li::before {
    content: ''; position: absolute; left: -7px; top: 50%; width: 12px; height: 12px; margin-top: -6px;
    border-top: 2px solid var(--blue); border-right: 2px solid var(--blue); transform: rotate(45deg); background: var(--bg);
  }
  .i { font: 700 12px var(--font-mono); letter-spacing: 0.14em; color: var(--blue); }
  .t { font-size: clamp(24px, 2.2vw, 32px); line-height: 0.95; }
  .s { font: var(--fs-small) var(--font-mono); color: var(--muted); }
  .last { padding-bottom: var(--s-6); }

  @media (max-width: 900px) {
    .steps { grid-template-columns: 1fr; }
    .steps li + li { border-left: 1px solid var(--line-strong); border-top: 0; }
    .steps li + li::before { left: 28px; top: -7px; margin-top: 0; transform: rotate(135deg); }
    .intro { font-size: 17px; }
  }
</style>
