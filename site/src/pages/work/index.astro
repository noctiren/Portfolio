---
import Base from '../../layouts/Base.astro';
import PageTitle from '../../components/PageTitle.astro';
import Stub from '../../components/Stub.astro';
import { caseStudies } from '../../data/site';
---
<Base title="Work" description="Case studies from Luke Petzer: multi-cloud Terraform, GitOps and secrets, an identity verification platform and a zero-downtime migration.">
  <PageTitle title="Work" outline="in the light" kicker="Selected case studies" />
  <Stub note="Case-study cards in the full design arrive in M2. For now, the list:">
    <ul class="list">
      {caseStudies.map((c) => (
        <li><a href={`/work/${c.slug}`}>{c.title}</a> <span class="co">{c.company}</span></li>
      ))}
    </ul>
  </Stub>
</Base>
<style>
  .list { padding-left: 1.2em; }
  .list li { margin: 8px 0; }
  .co { font: 12px var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-left: 8px; }
</style>
