---
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import { jobs, skills, education, certification } from '../data/cv';
---
<Base title="Experience" description="Luke Petzer's experience: DevOps Engineer at ixo, Software Engineer at BMTX and envel, plus skills, education and certification.">
  <PageTitle title="Experience" kicker="2018 – now">
    <p class="intro">From a Spring learnership to running a multi-cloud platform: backend first, then the infrastructure underneath it.</p>
  </PageTitle>

  <section class="tl-sec" aria-labelledby="tl-h">
    <div class="wrap">
      <h2 id="tl-h" class="visually-hidden">Timeline</h2>
      <ol class="tl">
        {jobs.map((j) => (
          <li class:list={['job rv', { current: j.current }]}>
            <span class="dot" aria-hidden="true"></span>
            <div class="when">
              <p class="period">{j.period}</p>
              <p class="where">{j.where}</p>
              {j.current && <p class="now">Current</p>}
            </div>
            <div class="what">
              <h3><span class="org display">{j.org}</span> <span class="role">{j.role}</span></h3>
              <p class="note">{j.note}</p>
              {j.points.length > 0 && (
                <ul class="pts">{j.points.map((p) => <li>{p}</li>)}</ul>
              )}
              {j.more && j.more.length > 0 && (
                <details class="more">
                  <summary>Full details <span class="cnt">+{j.more.length}</span></summary>
                  <ul class="pts">{j.more.map((p) => <li>{p}</li>)}</ul>
                </details>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section aria-labelledby="skills-h">
    <div class="wrap">
      <div class="sh"><span class="idx" aria-hidden="true">01</span><h2 id="skills-h" class="display wipe cast shadow-text">Skills</h2></div>
      <div class="skills">
        {skills.map((s) => (
          <div class="grp rv">
            <h3 class="label">{s.group}</h3>
            <ul class="tags">{s.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="last" aria-labelledby="edu-h">
    <div class="wrap">
      <div class="sh"><span class="idx" aria-hidden="true">02</span><h2 id="edu-h" class="display wipe cast shadow-text">Education</h2></div>
      <div class="edu">
        <div class="ed rv">
          <h3 class="label">School</h3>
          <p class="big">{education.school}</p>
          <p class="sub">{education.years}</p>
        </div>
        <div class="ed rv">
          <h3 class="label">Certification</h3>
          <p class="big">{certification}</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro { color: var(--muted); max-width: 36em; font-size: 19px; margin: 28px 0 0; }
  .tl-sec { padding-top: var(--s-4); }
  .tl { list-style: none; margin: 0; padding: 0; }
  .job { position: relative; display: grid; grid-template-columns: 200px 1fr; gap: 48px; padding: 0 0 56px 40px; }
  /* the timeline rail: each item draws its own segment as it reveals */
  .job::before {
    content: ''; position: absolute; left: 6px; top: 10px; bottom: -10px; width: 2px;
    background: linear-gradient(180deg, var(--blue), rgba(76, 155, 255, 0.15)); box-shadow: 0 0 10px rgba(76, 155, 255, 0.5);
    transform-origin: top;
  }
  .job:last-child::before { bottom: 40px; background: linear-gradient(180deg, var(--blue), transparent); }
  :global(.motion) .job::before { transform: scaleY(0); transition: transform 1.2s var(--ease-out) 0.2s; }
  :global(.motion) .job.in::before { transform: scaleY(1); }
  .dot {
    position: absolute; left: 0; top: 4px; width: 14px; height: 14px; border-radius: 50%;
    background: var(--bg); border: 2px solid var(--blue); box-shadow: 0 0 0 4px var(--bg), 0 0 14px var(--blue);
  }
  .current .dot { background: var(--ice); border-color: var(--ice); box-shadow: 0 0 0 4px var(--bg), 0 0 22px 4px var(--blue); }
  :global(.motion) .current .dot { animation: pulse 2.6s ease-in-out infinite; }
  @keyframes pulse { 50% { box-shadow: 0 0 0 4px var(--bg), 0 0 34px 10px rgba(76, 155, 255, 0.55); } }

  .when p { margin: 0; }
  .period { font: 700 var(--fs-label) / 1.4 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--ice); }
  .where { color: var(--muted); font-size: var(--fs-small); margin-top: 6px !important; }
  .now { display: inline-block; margin-top: 12px !important; font: 11px var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink); background: var(--blue); padding: 2px 8px; }
  h3 { margin: 0 0 12px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; }
  .org { font-size: var(--fs-h3); line-height: 0.9; color: var(--text); }
  .role { font: 700 var(--fs-label) var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--blue); }
  .note { color: var(--text); margin: 0 0 8px; max-width: 46em; }
  .pts { list-style: none; padding: 0; margin: 14px 0 0; max-width: 46em; }
  .pts li { position: relative; padding-left: 24px; margin: 10px 0; color: var(--muted); }
  .pts li::before { content: ''; position: absolute; left: 0; top: 0.8em; width: 12px; height: 2px; background: var(--blue); }

  .more { margin-top: 14px; max-width: 46em; }
  .more summary {
    display: inline-flex; align-items: center; gap: 10px; cursor: pointer; list-style: none; padding: 6px 0;
    font: 700 var(--fs-label) var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--ice);
  }
  .more summary::-webkit-details-marker { display: none; }
  .more summary::before {
    content: ''; width: 8px; height: 8px; border-right: 2px solid var(--blue); border-bottom: 2px solid var(--blue);
    transform: rotate(-45deg); margin-right: 2px;
  }
  .more[open] summary::before { transform: rotate(45deg) translate(-2px, -2px); }
  :global(.motion) .more summary::before { transition: transform 0.25s var(--ease-out); }
  .more summary:hover { color: #fff; }
  .more .cnt { font-weight: 400; color: var(--muted); letter-spacing: 0.06em; }
  .more .pts { margin-top: 4px; }
  .skills { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 36px 48px; }
  .grp { border-top: 1px solid var(--line); padding-top: 18px; }
  .grp h3, .ed h3 { margin: 0 0 14px; display: block; }
  .last { padding-bottom: var(--s-6); }
  .edu { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .ed { border-top: 1px solid var(--line); padding-top: 18px; }
  .big { font-size: clamp(20px, 2vw, 26px); line-height: 1.3; margin: 0; color: var(--text); }
  .sub { color: var(--muted); margin: 6px 0 0; font-family: var(--font-mono); font-size: var(--fs-small); }

  @media (max-width: 900px) {
    .job { grid-template-columns: 1fr; gap: 14px; padding-left: 36px; padding-bottom: 48px; }
    .edu { grid-template-columns: 1fr; gap: 32px; }
    .intro { font-size: 17px; }
  }
  @media (max-width: 560px) {
    .skills { grid-template-columns: 1fr; }
  }
</style>
